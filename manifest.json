{
  "manifest_version": 3,
  "name": "Vehicle Scraper and Lister",
  "version": "1.0",
  "description": "A browser extension to scrape and list vehicles.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.eddyseverything.com/*",
    "https://www.facebook.com/*"
  ]
}
