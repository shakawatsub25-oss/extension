{
  "manifest_version": 3,
  "name": "Vehicle Scraper and Lister",
  "version": "1.0",
  "description": "Scrapes vehicle listing data, rewrites it using AI, and auto-fills posting forms.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
