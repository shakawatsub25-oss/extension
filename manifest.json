{
  "manifest_version": 3,
  "name": "Vehicle Scraper and Lister",
  "version": "2.0",
  "description": "Scrapes vehicle listings from eddyseverything.com, rewrites them with AI, and auto-posts to Facebook Marketplace.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.eddyseverything.com/*",
    "https://*.facebook.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.eddyseverything.com/*"
      ],
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "https://*.facebook.com/marketplace/create/vehicle*"
      ],
      "js": [
        "facebook_poster.js"
      ]
    }
  ]
}
